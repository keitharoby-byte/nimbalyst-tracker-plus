{
  "version": 1,
  "queries": {
    "workspace-ready-items": {
      "version": 1,
      "kind": "predicate",
      "params": [],
      "label": "Ready items in this workspace",
      "definition": {
        "where": {
          "all": [
            { "field": "archived", "op": "eq", "value": false },
            { "field": "status", "op": "eq", "value": "ready" }
          ]
        },
        "sort": [
          { "field": "priority", "direction": "desc" },
          { "field": "updated", "direction": "desc" }
        ],
        "limit": 100,
        "includeTotalCount": true
      }
    },
    "workspace-walk-readiness": {
      "version": 1,
      "kind": "composed",
      "params": [],
      "label": "Evidence-backed readiness for explicitly staged walk roots",
      "definition": {
        "mode": "composed-v1",
        "select": {
          "where": {
            "all": [
              { "field": "archived", "op": "eq", "value": false },
              { "field": "walkStage", "op": "exists", "value": true },
              { "field": "buildState", "op": "eq", "value": "build-complete" }
            ]
          },
          "sort": [
            { "field": "priority", "direction": "desc" },
            { "field": "updated", "direction": "desc" }
          ],
          "limit": 8,
          "includeTotalCount": true
        },
        "traverse": {
          "expand": {
            "relationshipTypes": ["depends-on", "implements", "evidences"],
            "direction": "both",
            "maxDepth": 1,
            "edgeWhere": { "status": ["active", "blocked", "cleared"] },
            "externalEndpointBehavior": "boundary"
          },
          "limits": { "maxNodes": 64, "maxEdges": 128 }
        },
        "projection": "walk-readiness-v1",
        "failOn": { "truncation": true, "validation": false }
      }
    },
    "workspace-launch-scope": {
      "version": 1,
      "kind": "traversal",
      "params": ["launchKey"],
      "label": "Bounded active scope for one launch",
      "definition": {
        "roots": ["{launchKey}"],
        "membership": {
          "relationshipTypes": ["part-of-launch"],
          "direction": "incoming",
          "status": ["active"],
          "maxDepth": 1
        },
        "limits": { "maxNodes": 200, "maxEdges": 400 },
        "failOn": { "truncation": true, "validation": true }
      }
    }
  }
}
