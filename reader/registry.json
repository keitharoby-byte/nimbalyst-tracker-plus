{
  "version": 4,
  "terminalStatuses": ["done", "completed", "achieved", "closed", "shipped", "implemented", "released", "cancelled", "retired"],
  "scopeRoles": ["core", "supporting", "acceptance", "review", "evidence", "dependency-only"],
  "executableTypes": ["task", "timeline-item", "devops-item", "automation", "mr", "merge-request", "pull-request", "change-request"],
  "dispatchPolicy": {
    "dispatchableTypes": ["task", "bug"],
    "readyStatuses": ["ready", "dispatch-ready"],
    "qaPassStatuses": ["passed"],
    "eligibleLaunchStatuses": ["active", "ready", "in-progress"],
    "membershipRoles": ["core"],
    "contributionRoles": ["primary"],
    "admittedUnscopedTypes": [],
    "admissibleDatabaseRoutes": ["none", "not-required", "ready", "approved"],
    "clearHoldStates": ["clear", "none"],
    "clearCustodyStates": ["clear", "none", "vacant"],
    "survivorStates": ["survivor", "unique"],
    "clearCollisionStates": ["clear", "none"]
  },
  "dispatchEvidence": {
    "workflow": { "sources": [{ "kind": "field", "field": "status" }] },
    "packetRevision": { "sources": [{ "kind": "field", "field": "packetRevision" }] },
    "currentRevision": { "sources": [{ "kind": "field", "field": "currentRevision" }] },
    "isCurrentRevision": { "sources": [{ "kind": "field", "field": "isCurrentRevision" }] },
    "qaEvidenceRevision": { "sources": [{ "kind": "field", "field": "qaEvidenceRevision" }] },
    "qaStatus": { "sources": [{ "kind": "field", "field": "qaStatus" }] },
    "holdState": { "sources": [{ "kind": "field", "field": "holdState" }] },
    "databaseRouteState": { "sources": [{ "kind": "field", "field": "databaseRouteState" }] },
    "custodyState": { "sources": [{ "kind": "field", "field": "custodyState" }] },
    "survivorState": { "sources": [{ "kind": "field", "field": "survivorState" }] },
    "collisionState": { "sources": [{ "kind": "field", "field": "collisionState" }] },
    "executionConstraint": { "sources": [{ "kind": "field", "field": "executionConstraint" }] },
    "failureState": { "sources": [{ "kind": "field", "field": "failureState" }] },
    "supersededBy": { "sources": [{ "kind": "field", "field": "supersededBy" }] }
  },
  "relationshipTypes": {
    "part-of-launch": { "membership": true, "canBlock": false, "requiresScopeRole": true, "forbidsHardness": true },
    "governs": { "membership": false, "canBlock": false },
    "contributes-to": { "membership": false, "canBlock": false },
    "reviews": { "membership": false, "canBlock": "exit-criteria" },
    "evidences": { "membership": false, "canBlock": false },
    "depends-on": { "membership": false, "canBlock": "hard-serial" },
    "precedes": { "membership": false, "canBlock": false },
    "enables": { "membership": false, "canBlock": false },
    "coordinates-with": { "membership": false, "canBlock": false },
    "implements": { "membership": false, "canBlock": false },
    "related": { "membership": false, "canBlock": false, "symmetric": true }
  },
  "roles": {
    "coordinator": {
      "ownerAliases": ["coordinator", "coordination"],
      "attentionTags": ["needs-coordination", "coordination-requested"]
    }
  },
  "caps": {
    "queryLimitDefault": 50,
    "queryLimitMax": 200,
    "clauseDepthMax": 5,
    "clauseCountMax": 32,
    "listValuesMax": 64,
    "textTermMax": 200,
    "traverseNodesMax": 500,
    "traverseEdgesMax": 1000,
    "traverseDepthMax": 4,
    "traverseRootsMax": 8
  }
}
